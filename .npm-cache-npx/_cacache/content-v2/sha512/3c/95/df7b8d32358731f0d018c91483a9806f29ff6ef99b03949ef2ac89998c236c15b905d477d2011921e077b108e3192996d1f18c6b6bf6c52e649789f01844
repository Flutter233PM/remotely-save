mlns:x': 'ok:'\r\n});\r\n// <d:deep xmlns=\"ttt:\"><test/></d:deep>\r\nxml.ele('d:deep', {\r\n    'xmlns': 'ttt:'\r\n}).ele('test');\r\n// <d:node2>Ok1</d:node2>\r\nxml.ele('d:node2').add('Ok1')\r\n// <d:node2>Ok2</d:node2>\r\nxml.ele('d:node2').add('Ok2')\r\n// <d:tag/>\r\nxml.ele('d:tag')\r\n// <x:test/>\r\nxml.ele('x:test')\r\n// <d:nons>yes</d:nons>\r\nxml.ele('nons').add('yes')\r\n// <d:node2>Ok3</d:node2>\r\nxml.ele('d:node2').add('Ok3')\r\n\r\nconsole.log(xml.toJSON());\r\nconsole.log(xml.toXML());\r\n```\r\n","maintainers":[{"name":"adriencastex","email":"adrien.castex@gmail.com"}],"time":{"modified":"2022-06-29T05:35:53.983Z","created":"2017-07-15T08:48:51.854Z","1.0.0":"2017-07-15T08:48:51.854Z","1.0.1":"2017-07-15T09:14:54.618Z","1.0.2":"2018-05-06T12:57:52.515Z","1.0.3":"2018-05-06T15:18:19.927Z"},"homepage":"https://github.com/OpenMarshal/xml-js-builder#readme","keywords":["xml","json","js","parser","builder","namespace"],"repository":{"type":"git","url":"git+https://github.com/OpenMarshal/xml-js-builder.git"},"author":{"name":"Adrien Castex","email":"adrien.castex@gmail.com"},"bugs":{"url":"https://github.com/OpenMarshal/xml-js-builder/issues"},"license":"Unlicense","readmeFilename":"README.md"}